/* =====================================================================
   CIS SOCCER — mobile touch controls
   ===================================================================== */

.touch__stick-zone {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 46%;
    height: 68%;
}

.touch__stick-hint {
    position: absolute;
    left: 150px;
    bottom: 120px;
    -unity-font: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    -unity-font-definition: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    font-size: 13px;
    letter-spacing: 4px;
    color: rgba(255, 255, 255, 0.35);
}

.touch__stick-base {
    position: absolute;
    left: 110px;
    bottom: 90px;
    width: 220px;
    height: 220px;
    border-radius: 110px;
    background-color: rgba(8, 13, 24, 0.35);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    align-items: center;
    justify-content: center;
    opacity: 0.55;
    transition: opacity 0.15s, scale 0.15s;
}

.touch__stick-base--active {
    opacity: 1;
    scale: 1.04 1.04;
}

.touch__stick-ring {
    position: absolute;
    width: 150px;
    height: 150px;
    border-radius: 75px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
}

.touch__stick-knob {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgba(243, 246, 251, 0.85);
    border-width: 4px;
    border-color: rgba(0, 229, 143, 0.9);
}

.touch__cluster {
    position: absolute;
    right: 80px;
    bottom: 70px;
    width: 390px;
    height: 390px;
}

.touch__btn {
    position: absolute;
    width: 134px;
    height: 134px;
    border-radius: 67px;
    border-width: 4px;
    background-color: rgba(8, 13, 24, 0.55);
    align-items: center;
    justify-content: center;
    transition: scale 0.08s, background-color 0.08s;
}

.touch__btn--pressed {
    scale: 0.9 0.9;
}

.touch__btn--a { left: 128px; top: 256px; border-color: #1FA463; }
.touch__btn--b { left: 256px; top: 128px; border-color: #D93F4C; }
.touch__btn--x { left: 0; top: 128px; border-color: #2F7BEA; }
.touch__btn--y { left: 128px; top: 0; border-color: #E0A800; }

.touch__btn--a.touch__btn--pressed { background-color: #1FA463; }
.touch__btn--b.touch__btn--pressed { background-color: #D93F4C; }
.touch__btn--x.touch__btn--pressed { background-color: #2F7BEA; }
.touch__btn--y.touch__btn--pressed { background-color: #E0A800; }

.touch__btn-key {
    -unity-font: url("../../../Arts/UI/Fonts/Oswald-Bold.ttf");
    -unity-font-definition: url("../../../Arts/UI/Fonts/Oswald-Bold.ttf");
    font-size: 36px;
    color: #FFFFFF;
    -unity-text-align: middle-center;
}

.touch__btn-label {
    -unity-font: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    -unity-font-definition: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.8);
    margin-top: -4px;
}

.touch__pill {
    position: absolute;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 64px;
    padding: 0 24px;
    border-radius: 32px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(8, 13, 24, 0.55);
    transition: scale 0.08s, background-color 0.08s;
}

.touch__pill--switch {
    right: 330px;
    bottom: 470px;
}

.touch__pill-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    --icon-color: #F3F6FB;
}

.touch__pill-label {
    -unity-font: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    -unity-font-definition: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    font-size: 14px;
    letter-spacing: 3px;
    color: #FFFFFF;
}

.touch__pill.touch__btn--pressed {
    background-color: rgba(0, 229, 143, 0.75);
    scale: 0.94 0.94;
}

.touch__tactics {
    position: absolute;
    right: 150px;
    top: 40px;
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding: 0 6px;
    border-radius: 32px;
    background-color: rgba(8, 13, 24, 0.55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
}

.touch__tactics-label {
    -unity-font: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    -unity-font-definition: url("../../../Arts/UI/Fonts/Roboto-Bold.ttf");
    font-size: 12px;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 10px;
}

.touch__mini {
    width: 54px;
    height: 54px;
    border-radius: 27px;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.08);
    transition: scale 0.08s, background-color 0.08s;
}

.touch__mini.touch__btn--pressed {
    background-color: rgba(0, 229, 143, 0.75);
    scale: 0.9 0.9;
}

.touch__mini-icon {
    width: 24px;
    height: 24px;
    --icon-color: #FFFFFF;
}

.touch__pause {
    position: absolute;
    right: 48px;
    top: 36px;
    width: 76px;
    height: 76px;
    border-radius: 38px;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 13, 24, 0.6);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    transition: scale 0.08s, background-color 0.08s;
}

.touch__pause.touch__btn--pressed {
    background-color: rgba(0, 229, 143, 0.75);
    scale: 0.9 0.9;
}

.touch__pause-icon {
    width: 28px;
    height: 28px;
    --icon-color: #FFFFFF;
}
